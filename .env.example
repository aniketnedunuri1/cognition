# Data (required)
EXA_API_KEY=
APOLLO_API_KEY=          # Apollo Free plan is enough

# Local runner (agent.py). Alternative: an existing Claude Code login (`claude` CLI)
ANTHROPIC_API_KEY=


# HTTP mode (Devin): bearer token clients must send, and the public https URL (tunnel)
# the brief download links are built from
MCP_AUTH_TOKEN=
PUBLIC_BASE_URL=

# Optional: Slack incoming webhook for positioning-shift notices (log only if unset)
SLACK_WEBHOOK_URL=
