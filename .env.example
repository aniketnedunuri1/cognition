# Data (required)
EXA_API_KEY=
APOLLO_API_KEY=          # Apollo Free plan is enough

# Local runner (agent.py). Alternative: an existing Claude Code login (`claude` CLI)
ANTHROPIC_API_KEY=

# Google Doc briefs (optional): one-time OAuth into your own Drive. Defaults shown.
# GOOGLE_OAUTH_CLIENT_FILE=secrets/google-oauth-client.json   # OAuth client, type "Desktop app"
# GOOGLE_TOKEN_FILE=secrets/google-token.json                 # written by `python -m server.gdocs auth`

# HTTP mode (Devin): bearer token clients must send
MCP_AUTH_TOKEN=

# Optional: Slack incoming webhook for positioning-shift notices (log only if unset)
SLACK_WEBHOOK_URL=
