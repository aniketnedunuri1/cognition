# Secrets
.env
secrets/*
!secrets/.gitkeep

# Per-brief download tokens (access control for /briefs/<token>/ links)
briefs/.tokens.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Cache: ignored by default. The demo account's cache is committed once with
# `git add -f cache/`; tracked files stay tracked, later dev runs stay ignored.
cache/*
!cache/.gitkeep

.DS_Store
*.egg-info/

# Generated Devin Playbook text (rebuild from playbook/)
playbook/devin_*.generated.md
.cloudflared-devin.log

# Word lock files + generated org-chart docs
~$*.docx
org_charts.docx
